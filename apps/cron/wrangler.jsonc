{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "entity-builder-cron",
  "main": "src/index.ts",
  "account_id": "44799b719f2192a9f066f425aaff3106",
  "compatibility_date": "2026-06-01",
  "triggers": {
    // every 2 min: process queued sync steps; 05:30 UTC: queue daily
    // incremental jobs; 07:00 UTC: run opportunity analysis
    "crons": ["*/2 * * * *", "30 5 * * *", "0 7 * * *"]
  },
  // Same-account workers.dev fetches are blocked (error 1042); call the
  // web worker through a service binding instead.
  "services": [{ "binding": "WEB", "service": "entity-builder-web" }],
  "vars": {
    "SYNC_ENDPOINT": "https://entity-builder-web/api/internal/sync"
  }
}
