# Variable names only — never commit real values.

# Supabase / Postgres
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend only. Bypasses RLS. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (server-side web flow for Search Console)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# SERP / keyword provider
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# LLM (entity candidate extraction — proposals only, never auto-approved)
ANTHROPIC_API_KEY=

# Encryption key for stored Google refresh tokens (32-byte base64)
TOKEN_ENCRYPTION_KEY=
